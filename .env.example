# Required API keys for asset generation

# Google Gemini - for AI image generation
GOOGLE_API_KEY=

# ElevenLabs - for TTS narration, sound effects, and music
ELEVENLABS_API_KEY=

# Pexels - for stock photos and videos
PEXELS_API_KEY=

# Optional: Google Cloud - for Veo video generation
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Custom Search - for image search fallback (real people/places/things)
# Create at: https://programmablesearchengine.google.com/
# Enable "Image search" and "Search the entire web"
GOOGLE_CSE_ID=

# Pixabay - for free SFX downloads
PIXABAY_API_KEY=

# Freesound - for free SFX downloads
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
